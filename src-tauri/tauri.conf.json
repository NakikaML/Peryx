{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peryx",
  "version": "0.2.0",
  "identifier": "com.peryx.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "栖知 Peryx",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}